{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "rebaseWhen": "behind-base-branch",
  "prConcurrentLimit": 0,
  "prHourlyLimit": 0,
  "minimumReleaseAge": "7 days",
  "minimumReleaseAgeBehaviour": "timestamp-optional",
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update llama.cpp compiled by the inference service",
      "managerFilePatterns": ["/ares/inference-service/Dockerfile$/"],
      "matchStrings": ["ARG LLAMA_CPP_VERSION=(?<currentValue>\\S+)"],
      "depNameTemplate": "ggml-org/llama.cpp",
      "datasourceTemplate": "github-tags",
      "versioningTemplate": "regex:^b(?<major>\\d+)$"
    },
    {
      "customType": "regex",
      "description": "Update llama-swap downloaded by the inference service",
      "managerFilePatterns": ["/ares/inference-service/Dockerfile$/"],
      "matchStrings": ["ARG LLAMA_SWAP_VERSION=(?<currentValue>\\S+)"],
      "depNameTemplate": "mostlygeek/llama-swap",
      "datasourceTemplate": "github-tags",
      "extractVersionTemplate": "^v(?<version>\\d+)$",
      "versioningTemplate": "regex:^(?<major>\\d+)$"
    },
    {
      "customType": "regex",
      "description": "Update stable-diffusion.cpp compiled by the inference service",
      "managerFilePatterns": ["/ares/inference-service/Dockerfile$/"],
      "matchStrings": ["ARG STABLE_DIFFUSION_CPP_VERSION=(?<currentValue>\\S+)"],
      "depNameTemplate": "leejet/stable-diffusion.cpp",
      "datasourceTemplate": "github-tags",
      "versioningTemplate": "regex:^master-(?<major>\\d+)-[a-f0-9]+$"
    },
    {
      "customType": "regex",
      "description": "Update the Flux distribution used by flux_bootstrap_git",
      "managerFilePatterns": ["/terraform/flux\\.tf$/"],
      "matchStrings": ["resource \\\"flux_bootstrap_git\\\"[\\s\\S]*?version\\s*=\\s*\\\"(?<currentValue>v\\d+\\.\\d+\\.\\d+)\\\""],
      "depNameTemplate": "fluxcd/flux2",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Update CloudNativePG operand images",
      "managerFilePatterns": ["/flux/apps/.+\\.ya?ml$/"],
      "matchStrings": ["imageName:\\s*(?<depName>[^\\s:]+):(?<currentValue>[^\\s@]+)(?:@(?<currentDigest>sha256:[a-f0-9]{64}))?"],
      "datasourceTemplate": "docker",
      "depTypeTemplate": "cloudnative-pg-image",
      "autoReplaceStringTemplate": "imageName: {{{depName}}}:{{{newValue}}}{{#if newDigest}}@{{{newDigest}}}{{/if}}"
    },
    {
      "customType": "regex",
      "description": "Update CloudNativePG extension images",
      "managerFilePatterns": ["/flux/apps/.+\\.ya?ml$/"],
      "matchStrings": ["reference:\\s*(?<depName>[^\\s:]+):(?<currentValue>[^\\s@]+)(?:@(?<currentDigest>sha256:[a-f0-9]{64}))?"],
      "datasourceTemplate": "docker",
      "depTypeTemplate": "cloudnative-pg-extension-image",
      "autoReplaceStringTemplate": "reference: {{{depName}}}:{{{newValue}}}{{#if newDigest}}@{{{newDigest}}}{{/if}}"
    },
    {
      "customType": "regex",
      "description": "Update annotated versions in Flux manifests",
      "managerFilePatterns": ["/flux/apps/.+\\.ya?ml$/"],
      "matchStrings": ["# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: extractVersion=(?<extractVersion>\\S+))?(?: versioning=(?<versioning>\\S+))?\\s+version:\\s*['\\\"]?(?<currentValue>[^'\\\"\\s]+)"],
      "depTypeTemplate": "annotated-version"
    }
  ],
  "packageRules": [
    {
      "description": "Group inference service dependency updates together",
      "matchDatasources": ["github-tags"],
      "matchPackageNames": [
        "ggml-org/llama.cpp",
        "mostlygeek/llama-swap",
        "leejet/stable-diffusion.cpp"
      ],
      "groupName": "inference"
    },
    {
      "description": "Use the OpenTofu registry for Terraform by default",
      "matchDatasources": ["terraform-provider", "terraform-module"],
      "registryUrls": ["https://registry.opentofu.org"]
    },
    {
      "description": "Use the Terraform registry for Terraform modules in the coder directory, as that uses Terraform not OpenTofu",
      "matchDatasources": ["terraform-provider", "terraform-module"],
      "matchFileNames": ["terraform/modules/coder/templates/**/src/*.tf"],
      "registryUrls": ["https://registry.terraform.io"]
    },
    {
      "description": "Group all Immich updates together",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/immich-app/**"],
      "groupName": "immich"
    },
    {
      "description": "Track the CloudNativePG PostgreSQL image version",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/cloudnative-pg/postgresql"],
      "versioning": "regex:^(?<major>\\d+)-(?<compatibility>minimal-trixie)$"
    },
    {
      "description": "Keep pgvector on PostgreSQL 18 and Debian Trixie",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/cloudnative-pg/pgvector"],
      "matchDepTypes": ["cloudnative-pg-extension-image"],
      "versioning": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)-(?<compatibility>18-trixie)$",
      "groupName": "cloudnative-pg pgvector"
    },
    {
      "description": "Group the pgvector SQL and image versions",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/cloudnative-pg/pgvector"],
      "matchDepTypes": ["annotated-version"],
      "groupName": "cloudnative-pg pgvector"
    },
    {
      "description": "Keep VectorChord on PostgreSQL 17",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/tensorchord/cloudnative-vectorchord"],
      "versioning": "regex:^(?<compatibility>\\d+)\\.(?<major>\\d+)-(?<minor>\\d+)\\.(?<patch>\\d+)\\.(?<build>\\d+)$",
      "groupName": "immich"
    },
    {
      "description": "Disable digest-only updates for CloudNativePG images",
      "matchDatasources": ["docker"],
      "matchPackageNames": [
        "ghcr.io/cloudnative-pg/postgresql",
        "ghcr.io/cloudnative-pg/pgvector",
        "ghcr.io/tensorchord/cloudnative-vectorchord"
      ],
      "matchUpdateTypes": ["digest"],
      "enabled": false
    },
    {
      "description": "Group monitoring Helm chart updates together",
      "matchDatasources": ["helm"],
      "matchPackageNames": [
        "grafana",
        "prometheus-operator-crds",
        "victoria-logs-single",
        "victoria-metrics-k8s-stack"
      ],
      "groupName": "monitoring"
    },
    {
      "description": "Group keda Helm chart updates together",
      "matchDatasources": ["helm"],
      "matchPackageNames": [
        "keda",
        "keda-add-ons-http"
      ],
      "groupName": "keda"
    },
    {
      "description": "Disable digest updates for services that rebuild the image frequently",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/valkey-io/valkey"],
      "matchUpdateTypes": ["digest"],
      "enabled": false
    },
    {
      "description": "Handle versioning for sdr-enthusiasts images",
      "matchDatasources": ["docker"],
      "matchPackageNames": [
        "ghcr.io/sdr-enthusiasts/docker-adsb-ultrafeeder",
        "ghcr.io/sdr-enthusiasts/docker-flightradar24",
        "ghcr.io/sdr-enthusiasts/docker-piaware"
      ],
      "versioning": "regex:^latest-build-(?<major>\\d+)$",
      "groupName": "ultrafeeder"
    }
  ],
  "kubernetes": {
    "managerFilePatterns": ["/flux/.+\\.ya?ml$/"]
  },
  "flux": {
    "managerFilePatterns": ["/flux/.+\\.ya?ml$/"]
  },
  "ignoreDeps": [
    "ghcr.io/fluxcd/helm-controller",
    "ghcr.io/fluxcd/image-automation-controller",
    "ghcr.io/fluxcd/image-reflector-controller",
    "ghcr.io/fluxcd/kustomize-controller",
    "ghcr.io/fluxcd/notification-controller",
    "ghcr.io/fluxcd/source-controller",
    "registry.fedoraproject.org/fedora",
    "registry.fedoraproject.org/fedora-minimal"
  ]
}
