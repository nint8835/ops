NODE_ENV=production
APP_ENV=production
PORT=3005
METRICS_ENABLED=true
METRICS_PORT=9090
HAPPIER_SERVER_FLAVOR=light
HAPPIER_DB_PROVIDER=sqlite
HAPPIER_FILES_BACKEND=local
HAPPIER_SERVER_LIGHT_DATA_DIR=/data/server-light
HAPPIER_SOCKET_ADAPTER=memory
SERVER_ROLE=all
HAPPIER_PUBLIC_SERVER_URL=https://agents.bootleg.technology
HAPPIER_WEBAPP_URL=https://agents.bootleg.technology
AUTH_ANONYMOUS_SIGNUP_ENABLED=false
AUTH_SIGNUP_PROVIDERS=github
AUTH_REQUIRED_LOGIN_PROVIDERS=github
AUTH_GITHUB_ALLOWED_USERS=nint8835
GITHUB_REDIRECT_URL=https://agents.bootleg.technology/v1/oauth/github/callback
HAPPIER_FEATURE_ENCRYPTION__STORAGE_POLICY=optional|plaintext_only
HAPPIER_FEATURE_E2EE__KEYLESS_ACCOUNTS_ENABLED=1
HAPPIER_FEATURE_AUTH_OAUTH__KEYLESS_ENABLED=1
HAPPIER_FEATURE_AUTH_OAUTH__KEYLESS_PROVIDERS=github
HAPPIER_FEATURE_AUTH_OAUTH__KEYLESS_AUTO_PROVISION=1
